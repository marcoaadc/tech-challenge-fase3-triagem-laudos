# Copie para .env e ajuste se necessario. Todas as chaves tem defaults sensatos.
# Prefixo TRIAGE_ (pydantic-settings).

# Aplicacao
TRIAGE_ENVIRONMENT=local
TRIAGE_LOG_LEVEL=INFO
TRIAGE_LOG_JSON=false

# Servidor
TRIAGE_HOST=0.0.0.0
TRIAGE_PORT=8000
TRIAGE_WORKERS=1                   # >1 exige PROMETHEUS_MULTIPROC_DIR (o entrypoint do container cuida disso)

# Seguranca (vazio/0 = desativado; defina em producao)
TRIAGE_API_KEY=
TRIAGE_RATE_LIMIT_PER_MINUTE=0

# Modelo / inferencia
TRIAGE_MODELS_DIR=models
TRIAGE_MODEL_BACKEND=onnx          # onnx | sklearn
TRIAGE_ONNX_INTRA_OP_THREADS=1
TRIAGE_MAX_TEXT_LENGTH=20000
TRIAGE_MAX_BATCH_SIZE=64

# Pipeline de treino
TRIAGE_DATA_DIR=data
TRIAGE_REPORTS_DIR=reports
TRIAGE_SEED=42
# TRIAGE_MLFLOW_TRACKING_URI=file:./mlruns
TRIAGE_MLFLOW_EXPERIMENT=triagem-laudos
